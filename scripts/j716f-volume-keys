#!/usr/bin/env python3
import glob
import os
import select
import struct
import subprocess
import time

STEP = 5
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
KEY_MUTE = 113
last = {}
COOKIE = os.environ.get('PULSE_COOKIE', '/home/j716f/.config/pulse/cookie')

def pactl(*args):
    env = {
        'XDG_RUNTIME_DIR': '/run/user/1001',
        'HOME': '/home/j716f',
        'PULSE_SERVER': 'unix:/run/user/1001/pulse/native',
    }
    try:
        subprocess.run(['runuser', '-u', 'player', '--', 'env'] +
                       [f'{k}={v}' for k, v in env.items()] +
                       ['pactl'] + list(args),
                       stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL,
                       timeout=3)
    except Exception:
        pass

def handle(code, value):
    now = time.monotonic()
    if value not in (1, 2):
        return
    if value == 2 and now - last.get(code, 0) < 0.04:
        return
    last[code] = now
    if code == KEY_VOLUMEUP:
        pactl('set-sink-mute', '@DEFAULT_SINK@', '0')
        pactl('set-sink-volume', '@DEFAULT_SINK@', f'+{STEP}%')
    elif code == KEY_VOLUMEDOWN:
        pactl('set-sink-mute', '@DEFAULT_SINK@', '0')
        pactl('set-sink-volume', '@DEFAULT_SINK@', f'-{STEP}%')
    elif code == KEY_MUTE:
        pactl('set-sink-mute', '@DEFAULT_SINK@', 'toggle')

def main():
    fds = {}
    for path in glob.glob('/dev/input/event*'):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            fds[fd] = path
        except Exception:
            pass
    if not fds:
        print('no input devices', flush=True)
        return 1
    print('watching', ','.join(fds.values()), flush=True)
    while True:
        try:
            ready, _, _ = select.select(list(fds), [], [], 5)
        except Exception:
            time.sleep(1)
            continue
        for fd in ready:
            try:
                data = os.read(fd, 24)
            except Exception:
                continue
            if len(data) < 24:
                continue
            _, _, etype, code, value = struct.unpack('@llHHi', data)
            if etype == 1:  # EV_KEY
                handle(code, value)

if __name__ == '__main__':
    raise SystemExit(main())
