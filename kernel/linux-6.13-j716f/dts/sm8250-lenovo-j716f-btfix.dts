		status = "okay";

		pinctrl-names = "default";
		pinctrl-0 = <&cam_mclk2_active &cam_reset2_active>;

		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "mclk";
		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
		assigned-clock-rates = <24000000>;
		clock-frequency = <24000000>;

		resetb-gpios = <&tlmm 78 GPIO_ACTIVE_LOW>;

		iovdd-supply = <&vreg_l7f_1p8>;
		dvdd12-supply = <&vreg_l3f_1p2>;
		avdd21-supply = <&vreg_l6f_2p8>;
		bob-supply = <&vreg_bob>;
		tof-supply = <&vdd_tof>;

		port {
			gc5035_ir34_ep: endpoint {
				data-lanes = <0 1>;
				clock-lanes = <7>;
				link-frequencies = /bits/ 64 <438000000>;
			};
		};
	};
};

