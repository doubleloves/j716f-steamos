&tlmm {
	cam_mclk0_active: cam-mclk0-active-state {
		pins = "gpio94";
		function = "cam_mclk";
		drive-strength = <16>;
		bias-disable;
	};

	cam_reset0_active: cam-reset0-active-state {
		pins = "gpio93";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	cam_mclk1_active: cam-mclk1-active-state {
		pins = "gpio95";
		function = "cam_mclk";
		drive-strength = <16>;
		bias-disable;
	};

	cam_reset1_active: cam-reset1-active-state {
		pins = "gpio92";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	cam_mclk2_active: cam-mclk2-active-state {
		pins = "gpio96";
		function = "cam_mclk";
		drive-strength = <16>;
		bias-disable;
	};

	cam_reset2_active: cam-reset2-active-state {
		pins = "gpio78";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	cam_mclk3_active: cam-mclk3-active-state {
		pins = "gpio97";
		function = "cam_mclk";
		drive-strength = <16>;
		bias-disable;
	};

	cam_reset3_active: cam-reset3-active-state {
		pins = "gpio109";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};
};

&sound {
	qcom,msm-dmic-en-gpio = <&tlmm 12 GPIO_ACTIVE_LOW>;
	qcom,msm-dmic-sel-gpio = <&tlmm 1 GPIO_ACTIVE_HIGH>;

	compatible = "qcom,sm8250-sndcard";
	model = "Lenovo Xiaoxin Pad Pro 2021";
	pinctrl-names = "default";
	pinctrl-0 = <&pri_mi2s_active>, <&tert_mi2s_capture_active>;

	audio-routing =
		"TX SWR_ADC0", "ADC1_OUTPUT",
		"TX SWR_ADC1", "ADC2_OUTPUT",
		"TX SWR_ADC2", "ADC3_OUTPUT",
		"TX SWR_ADC3", "ADC4_OUTPUT",
		"TX SWR_DMIC0", "DMIC1_OUTPUT",
		"TX SWR_DMIC1", "DMIC2_OUTPUT",
		"TX SWR_DMIC2", "DMIC3_OUTPUT",
		"TX SWR_DMIC3", "DMIC4_OUTPUT",
		"TX SWR_DMIC4", "DMIC5_OUTPUT",
		"TX SWR_DMIC5", "DMIC6_OUTPUT",
		"TX SWR_DMIC6", "DMIC7_OUTPUT",
		"TX SWR_DMIC7", "DMIC8_OUTPUT";

	mm1-dai-link {
		link-name = "MultiMedia1";

		cpu {
			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
		};
	};

	mm2-dai-link {
		link-name = "MultiMedia2";

		cpu {
			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
		};
	};

	mm3-dai-link {
		link-name = "MultiMedia3";

		cpu {
			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
		};
	};

	primary-rx-dai-link {
		link-name = "Primary MI2S Playback";

		cpu {
			sound-dai = <&q6afedai PRIMARY_MI2S_RX>;
		};

		platform {
			sound-dai = <&q6routing>;
		};

		codec {
			sound-dai = <&cs35l41_1 0>, <&cs35l41_2 0>,
				    <&cs35l41_3 0>, <&cs35l41_4 0>;
		};
	};

	wcd-playback-dai-link {
		link-name = "WCD Playback";

		cpu {
			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
		};

		codec {
			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
		};

		platform {
			sound-dai = <&q6routing>;
		};
	};

	wcd-capture-dai-link {
		link-name = "WCD Capture";

		cpu {
			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
		};

		codec {
			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
		};

		platform {
			sound-dai = <&q6routing>;
		};
	};

	tert-mi2s-capture-dai-link {
		link-name = "TERT MI2S Capture";

		cpu {
			sound-dai = <&q6afedai TERTIARY_MI2S_TX>;
		};

		platform {
			sound-dai = <&q6routing>;
		};

		codec {
			sound-dai = <&es7210>;
		};
	};

	quat-mi2s-capture-dai-link {
		link-name = "QUAT MI2S Capture";

		cpu {
			sound-dai = <&q6afedai QUATERNARY_MI2S_TX>;
		};

		platform {
			sound-dai = <&q6routing>;
		};

		codec {
			sound-dai = <&es7210>;
		};
	};
};

&swr1 {
	status = "okay";

	wcd_rx: wcd9380-rx@0,4 {
		compatible = "sdw20217010d00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5>;
	};
};

&swr2 {
	status = "okay";

	wcd_tx: wcd9380-tx@0,3 {
		compatible = "sdw20217010d00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 3 4 5>;
	};
};

&rxmacro {
	status = "okay";
};

&lpass_tlmm {
	dmic23_active: dmic23-active-state {
		clk-pins {
			pins = "gpio8";
			function = "dmic2_clk";
			drive-strength = <8>;
			output-high;
		};

		data-pins {
			pins = "gpio9";
			function = "dmic2_data";
			drive-strength = <8>;
			input-enable;
		};
	};
};

&vamacro {
	qcom,dmic-sample-rate = <2400000>;
};

&txmacro {
	status = "okay";
	pinctrl-0 = <&tx_swr_active &dmic23_active>;
};

&tlmm {
	gpio-reserved-ranges = <40 4>;

	/* j716f/77: TERT MI2S capture needs BOTH SD lines.
	 * Upstream tert_mi2s_active only muxes data0 (gpio134), but
	 * q6afedai dai@21 declares qcom,sd-lines = <0 1> and the vendor
	 * mi2s2 group is 133/135/134/137. Without gpio137 -> mi2s2_data1
	 * the second SD line stays in GPIO func0 (verified via debugfs),
	 * so AFE samples a floating pin and the captured data is all zero.
	 * This state is byte-for-byte tert_mi2s_active plus data1. */
	tert_mi2s_capture_active: tert-mi2s-capture-active-state {
		sck-pins {
			pins = "gpio133";
			function = "mi2s2_sck";
			drive-strength = <8>;
			bias-disable;
		};

		data0-pins {
			pins = "gpio134";
			function = "mi2s2_data0";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};

		ws-pins {
			pins = "gpio135";
			function = "mi2s2_ws";
			drive-strength = <8>;
			output-high;
		};

		data1-pins {
			pins = "gpio137";
			function = "mi2s2_data1";
			drive-strength = <8>;
			bias-disable;
			input-enable;
		};
	};

	cs35l41_2_irq_default: cs35l41_2_irq_default {
		pins = "gpio113";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	cs35l41_4_irq_default: cs35l41_4_irq_default {
		pins = "gpio68";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	cs35l41_1_irq_default: cs35l41_1_irq_default {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	cs35l41_3_irq_default: cs35l41_3_irq_default {
		pins = "gpio126";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	cs35l41_reset_default: cs35l41_reset_default {
		pins = "gpio131";
		function = "gpio";
		output-high;
		bias-pull-up;
		drive-strength = <16>;
	};

	sdc2_default_state: sdc2-default-state {
		clk-pins {
			pins = "sdc2_clk";
			drive-strength = <16>;
			bias-disable;
		};

		cmd-pins {
			pins = "sdc2_cmd";
			drive-strength = <16>;
			bias-pull-up;
		};

		data-pins {
			pins = "sdc2_data";
			drive-strength = <16>;
			bias-pull-up;
		};
	};

	sdc2_gate: sdc2-gate-state {
		pins = "gpio116";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		output-high;
	};

	bt_en: bt-en-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-pull-up;
	};

	mcu_default: mcu-default-state {
		pins = "gpio11", "gpio14", "gpio25";
		function = "gpio";
		bias-disable;
	};

	wlan_en: wlan-en-state {
		pins = "gpio20";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-pull-up;
	};

	panel_avdd_default: panel-avdd-default-state {
		pins = "gpio61";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	sde_te_active_sleep: sde-te-active-sleep-state {
		pins = "gpio66";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	sde_dsi_sleep: sde-dsi-sleep-state {
		pins = "gpio75";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-high;
	};

	sde_dsi_active: sde-dsi-active-state {
		pins = "gpio75";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	ts_active: ts-active-state {
		pins = "gpio38", "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_int_sleep: ts-int-sleep-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_reset_sleep: ts-reset-sleep-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_release: ts-release-state {
		pins = "gpio38", "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&uart6 {
	status = "okay";

	bluetooth {
		compatible = "qcom,qca6390-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddbtcmx-supply = <&vreg_pmu_btcmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
	};
};

&ufs_mem_hc {
	vcc-supply = <&vreg_l17a_2p5>;
	vcc-max-microamp = <800000>;
	vccq-supply = <&vreg_l6a_1p2>;
	vccq-max-microamp = <800000>;
	vccq2-supply = <&vreg_s4a_1p8>;
	vccq2-max-microamp = <800000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l5a_0p88>;
	vdda-pll-supply = <&vreg_l9a_1p2>;

	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
};

&usb_1_hsphy {
	vdda-pll-supply = <&vreg_l5a_0p88>;
	vdda18-supply = <&vreg_l12a_1p8>;
	vdda33-supply = <&vreg_l2a_3p1>;

	status = "okay";
};

&usb_1_qmpphy {
	vdda-phy-supply = <&vreg_l9a_1p2>;
	vdda-pll-supply = <&vreg_l18a_0p9>;

	status = "okay";
};

&venus {
	firmware-name = "qcom/sm8250/LENOVO/J716F/venus.mbn";
	status = "okay";
};

&pm8150b_charger {
	monitored-battery = <&battery>;
	/* Read the PD contract from the Type-C port controller. */
	power-supplies = <&pm8150b_typec>;
	status = "okay";
};

&pm8150b_fg {
	monitored-battery = <&battery>;
	/* The PM8150B FG SRAM is owned by the ADSP firmware on this board;
	 * accessing it from the AP floods the log with "disallowed SPMI write"
	 * and provides no calibrated profile. Keep it disabled and use the
	 * simple-battery data + bq27541 gauge instead. */
	status = "disabled";
};

&pm8150b_typec {
	vdd-pdphy-supply = <&vreg_l2a_3p1>;
	status = "okay";

	connector {
		compatible = "usb-c-connector";

		power-role = "sink";
		data-role = "device";
		self-powered;

		op-sink-microwatt = <10000000>;

		/*
		 * 5V/3A for compatibility and 9V/3A for the stock 30W PD
		 * charger. The PM8150B high-voltage input path is configured
		 * by the SMB5 driver (HVDCP_EN + HVDCP_AUTH_ALG_EN).
		 */
		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
			     PDO_FIXED(9000, 3000, 0)>;
	};
};

&pm8150b_vbus {
	regulator-min-microamp = <500000>;
	regulator-max-microamp = <3000000>;
	status = "okay";
};

/* PM8150 RTC is read-only from the AP on this platform (the RTC write
 * APID is owned by the RPM firmware) -> do not enable allow-set-time,
 * which only floods the log with "disallowed SPMI write" errors.
 */

&lpass_tlmm {
	qua_mi2s_active: qua-mi2s-active-state {
		sclk-pins {
			pins = "gpio0";
			function = "qua_mi2s_sclk";
			drive-strength = <2>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio1";
			function = "qua_mi2s_ws";
			drive-strength = <2>;
			bias-disable;
		};

		data-pins {
			pins = "gpio2", "gpio3", "gpio4";
			function = "qua_mi2s_data";
			drive-strength = <2>;
			bias-disable;
		};
	};
};
