+static ssize_t dbmdx_io_value_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return dbmdx_reg_show_long(dev, DBMDX_VA_IO_PORT_VALUE_HI,
+				  DBMDX_VA_IO_PORT_VALUE_LO, attr, buf);
