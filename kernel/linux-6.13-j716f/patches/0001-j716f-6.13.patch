+static int q6lsm_probe(struct apr_device *adev)
+{
+	struct q6lsm *lsm;
+
+	lsm = devm_kzalloc(&adev->dev, sizeof(*lsm), GFP_KERNEL);
+	if (!lsm)
+		return -ENOMEM;
+	lsm->dev = &adev->dev;
+	lsm->adev = adev;
+	lsm->session = 1;
+	mutex_init(&lsm->lock);
+	init_completion(&lsm->cmd_done);
+	dev_set_drvdata(&adev->dev, lsm);
+	q6lsm_global = lsm;
+	dev_info(lsm->dev, "j716f-mic: q6lsm probe\n");
