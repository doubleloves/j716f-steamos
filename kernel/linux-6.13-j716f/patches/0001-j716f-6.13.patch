+			function = "mi2s2_ws";
+			drive-strength = <8>;
+			output-high;
+		};
+
+		data1-pins {
+			pins = "gpio137";
+			function = "mi2s2_data1";
+			drive-strength = <8>;
+			bias-disable;
+			input-enable;
+		};
+	};
