+static int tx_macro_validate_dmic_sample_rate(u32 rate, struct tx_macro *tx)
+{
+	unsigned int div;
+
+	if (!rate || TX_MACRO_DMIC_MCLK_FREQ % rate)
+		return -EINVAL;
+
+	div = TX_MACRO_DMIC_MCLK_FREQ / rate;
+	switch (div) {
+	case 2:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_2;
+		break;
+	case 3:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_3;
+		break;
+	case 4:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_4;
+		break;
+	case 6:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_6;
+		break;
+	case 8:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_8;
+		break;
+	case 16:
+		tx->dmic_clk_div = TX_MACRO_CLK_DIV_16;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
