+static int q6afe_port_set_param_v3(struct q6afe_port *port, void *data,
+				   int param_id, int module_id, int psize)
+{
+	struct afe_port_cmd_set_param_v3 *param;
+	struct afe_param_hdr_v3 *phdr;
+	struct q6afe *afe = port->afe;
+	struct apr_pkt *pkt;
+	int pkt_size, ret;
+	void *p;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*param) + sizeof(*phdr) + psize;
+	p = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	param = p + APR_HDR_SIZE;
+	phdr = (void *)param + sizeof(*param);
+	memcpy((void *)phdr + sizeof(*phdr), data, psize);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = 0;
+	pkt->hdr.dest_port = 0;
+	pkt->hdr.token = port->token;
+	pkt->hdr.opcode = AFE_PORT_CMD_SET_PARAM_V3;
+
+	param->port_id = port->id;
+	param->reserved = 0;
+	param->data_payload_addr_lsw = 0;
+	param->data_payload_addr_msw = 0;
+	param->mem_map_handle = 0;
+	param->payload_size = sizeof(*phdr) + psize;
+
+	phdr->module_id = module_id;
+	phdr->instance_id = 0;
+	phdr->reserved = 0;
+	phdr->param_id = param_id;
+	phdr->param_size = psize;
+
+	ret = afe_apr_send_pkt(afe, pkt, port, AFE_PORT_CMD_SET_PARAM_V3);
+	if (ret)
+		dev_err(afe->dev, "j716f: AFE v3 param 0x%x failed %d\n",
+			param_id, ret);
+
+	kfree(pkt);
+	return ret;
+}
