+static int uart_open_thread(void *data)
+{
+	int ret;
+	struct dbmdx_uart_private *p = (struct dbmdx_uart_private *)data;
+
+	ret = uart_open_file(p);
+	while (!kthread_should_stop())
+		usleep_range(10000, 11000);
+	return ret;
+}
