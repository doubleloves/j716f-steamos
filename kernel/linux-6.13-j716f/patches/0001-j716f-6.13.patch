+        }
+        for (cnt = 0;
+             cnt < sizeof(es7210_tdm_reg_common_cfg2) /
+             sizeof(es7210_tdm_reg_common_cfg2[0]);
+             cnt++) {
+                es7210_multi_chips_write(
