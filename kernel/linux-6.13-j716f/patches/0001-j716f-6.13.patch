+
+	dev_dbg(uart_p->dev, "%s\n", __func__);
+
+	if (p->pdata->uart_low_speed_enabled) {
+
+		ret = dbmd4_uart_switch_to_buffering_speed(p);
+
+		if (ret) {
+			dev_err(p->dev,
+				"%s: failed to send change speed command\n",
