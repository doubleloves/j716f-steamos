+				p->pdata->gpio_d2strap1_rst_val);
+
+	dev_dbg(p->dev, "%s: %d==>gpio%d\n", __func__, 0, p->cur_reset_gpio);
+
+	gpio_set_value(p->cur_reset_gpio, 0);
