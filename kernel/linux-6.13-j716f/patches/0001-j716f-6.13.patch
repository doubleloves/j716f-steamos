+static ssize_t dbmdx_va_max_sample_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	return dbmdx_reg_show(dev, DBMDX_VA_LAST_MAX_SMP_VALUE, attr, buf);
+}
