+static int es7210_set_dai_fmt(struct snd_soc_dai *codec_dai,
+                              unsigned int fmt)
+{
+        switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+        case SND_SOC_DAIFMT_CBP_CFP:
+                /* codec provides BCLK/LRCK: master, MODE_CFG bit0 = 1 */
+                es7210_multi_chips_update_bits(ES7210_MODE_CFG_REG08, 0x01, 0x01);
+                break;
+        case SND_SOC_DAIFMT_CBC_CFC:
+                /* codec consumes BCLK/LRCK: slave, MODE_CFG bit0 = 0 */
+                es7210_multi_chips_update_bits(ES7210_MODE_CFG_REG08, 0x01, 0x00);
+                break;
+        default:
+                return -EINVAL;
+        }
+        pr_info("j716f-mic: es7210 set_fmt fmt=0x%x\n", fmt);
+        return 0;
