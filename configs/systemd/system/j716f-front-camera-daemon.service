[Unit]
Description=J716F S5K4H7 -> v4l2loopback front camera daemon
After=systemd-modules-load.service j716f-camera-setup.service j716f-camera-daemon.service
Wants=systemd-modules-load.service
Requires=j716f-camera-setup.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=J716F_VFLIP=0
Environment=J716F_HFLIP=0
ExecStart=/usr/local/bin/j716f-front-daemon
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
